{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mantispy AnnData schema",
    "schema_version": "2.0",
    "status": "experimental",
    "description": "Experimental contract for an AnnData object produced by mantispy, the target of the schema migration. 2.0 is a breaking redesign of the previous internal 1.0 schema; it may change without deprecation until the migration phases (identity, CellProfiler/SpatialData, controls, aggregation, provenance, results) are complete and the maintainers declare it stable. X holds float32 feature values; obs holds Metadata_ columns identifying where each profile came from; var holds the parsed feature annotation including feature_kind; uns['mantispy'] holds the core descriptors (schema_version, schema_status, resolution, grouped_by, history), the channel vocabulary and the result tables. The prose contract lives in spec/morphology-schema-2.0.md. 0.1 and 1.0 objects migrate with mt.io.migrate.",
    "migrates_from": ["0.1", "1.0", "2.0"],
    "x_dtype": "float32",
    "resolutions": ["object", "well", "aggregate"],
    "feature_kinds": ["measurement", "embedding", "derived"],
    "required_obs": {
        "object": ["Metadata_Plate", "Metadata_Well", "Metadata_ImageID", "Metadata_ObjectType", "Metadata_ObjectNumber"],
        "well": ["Metadata_Plate", "Metadata_Well"],
        "aggregate": []
    },
    "reserved_obs": [
        "Metadata_Batch",
        "Metadata_Source",
        "Metadata_Site",
        "Metadata_ImageID",
        "Metadata_ImageNumber",
        "Metadata_ObjectType",
        "Metadata_ObjectNumber",
        "Metadata_Perturbation",
        "Metadata_Perturbation_Type",
        "Metadata_Compound",
        "Metadata_Concentration",
        "Metadata_ConcentrationRecorded",
        "Metadata_MOA",
        "Metadata_CellLine",
        "Metadata_Control",
        "Metadata_CellCount",
        "Metadata_SiteCount",
        "Metadata_Center_X",
        "Metadata_Center_Y",
        "Metadata_Control_Type",
        "Metadata_CellCyclePhase",
        "Metadata_LocalDensity",
        "Metadata_ReplicateCount",
        "Metadata_JCP2022",
        "Metadata_InChIKey",
        "Metadata_PlateType",
        "Metadata_Barcode",
        "Metadata_Gene",
        "Metadata_sgRNA",
        "Metadata_Construct",
        "Metadata_Allele",
        "Metadata_BarcodeQuality"
    ],
    "required_var": [
        "object",
        "feature_group",
        "feature",
        "channel",
        "scale",
        "angle",
        "gray_levels",
        "radial_bin",
        "params",
        "is_feature",
        "feature_kind"
    ],
    "optional_var": [
        "selected",
        "selected_chatterjee",
        "chatterjee_xi",
        "degenerate_scale",
        "icc",
        "icc_selected",
        "batch_pvalue",
        "batch_qvalue",
        "batch_sensitive",
        "qc_n_nan",
        "qc_variance",
        "qc_n_unique",
        "original_name"
    ],
    "required_uns": [
        "schema_version",
        "schema_status",
        "resolution",
        "grouped_by",
        "history"
    ],
    "uns_keys": [
        "schema_version",
        "schema_status",
        "resolution",
        "grouped_by",
        "history",
        "channels",
        "dataset",
        "image_table",
        "params",
        "aggregated_from",
        "consensus_from",
        "truth"
    ],
    "uns_results": [
        "feature_select",
        "image_qc",
        "well_qc",
        "plate_position",
        "plate_position_detection",
        "chromosome_arm",
        "map",
        "percent_replicating",
        "grit",
        "effect",
        "wasserstein",
        "consensus_weights",
        "hits",
        "empirical_fdr",
        "edistance",
        "edistance_pairwise",
        "dose_response",
        "moa",
        "moa_confusion",
        "moa_enrichment",
        "rank_features",
        "rank_sets",
        "composition_test",
        "subpopulation_hits",
        "replicate_saturation",
        "cytotoxicity",
        "pathway_coherence",
        "enrich_hits"
    ]
}
