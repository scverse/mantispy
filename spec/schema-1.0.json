{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mantispy AnnData schema",
    "schema_version": "1.0",
    "status": "frozen",
    "description": "Frozen contract for an AnnData object produced by mantispy. X holds float32 feature values; obs holds Metadata_ columns identifying where each profile came from; var holds the parsed feature annotation; uns['mantispy'] holds the schema version, resolution, provenance and the result tables. Names in this file are stable: anything removed gets two minor releases of deprecation first. 0.1 objects migrate with ms.io.migrate.",
    "migrates_from": ["0.1", "1.0"],
    "x_dtype": "float32",
    "resolutions": ["cell", "well", "perturbation"],
    "required_obs": {
        "cell": ["Metadata_Plate", "Metadata_Well"],
        "well": ["Metadata_Plate", "Metadata_Well"],
        "perturbation": []
    },
    "reserved_obs": [
        "Metadata_Batch",
        "Metadata_Source",
        "Metadata_Site",
        "Metadata_ImageNumber",
        "Metadata_ObjectNumber",
        "Metadata_Perturbation",
        "Metadata_Compound",
        "Metadata_Concentration",
        "Metadata_MOA",
        "Metadata_Control",
        "Metadata_CellCount",
        "Metadata_Center_X",
        "Metadata_Center_Y",
        "Metadata_Control_Type",
        "Metadata_CellCyclePhase",
        "Metadata_LocalDensity",
        "Metadata_ReplicateCount",
        "Metadata_JCP2022",
        "Metadata_InChIKey",
        "Metadata_PlateType",
        "Metadata_Barcode",
        "Metadata_Gene",
        "Metadata_sgRNA",
        "Metadata_BarcodeQuality"
    ],
    "required_var": [
        "object",
        "feature_group",
        "feature",
        "channel",
        "scale",
        "angle",
        "gray_levels",
        "radial_bin",
        "params",
        "is_feature"
    ],
    "optional_var": [
        "selected",
        "selected_chatterjee",
        "chatterjee_xi",
        "degenerate_scale",
        "icc",
        "icc_selected",
        "batch_pvalue",
        "batch_qvalue",
        "batch_sensitive",
        "qc_n_nan",
        "qc_variance",
        "qc_n_unique",
        "original_name"
    ],
    "uns_keys": [
        "schema_version",
        "resolution",
        "channels",
        "dataset",
        "image_table",
        "params",
        "aggregated_from",
        "consensus_from",
        "truth"
    ],
    "uns_results": [
        "feature_select",
        "image_qc",
        "well_qc",
        "plate_position",
        "map",
        "percent_replicating",
        "grit",
        "effect",
        "wasserstein",
        "consensus_weights",
        "hits",
        "edistance",
        "edistance_pairwise",
        "dose_response",
        "moa",
        "moa_confusion",
        "moa_enrichment",
        "rank_features",
        "rank_sets",
        "composition_test",
        "subpopulation_hits",
        "replicate_saturation",
        "cytotoxicity",
        "pathway_coherence",
        "enrich_hits"
    ]
}
